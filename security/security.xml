<odoo>
    <record id="group_gxp_role_admin" model="res.groups">
        <field name="name">GxP Admin</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_gxp_role_author" model="res.groups">
        <field name="name">GxP Author</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_gxp_role_reviewer" model="res.groups">
        <field name="name">GxP Reviewer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_gxp_role_approver" model="res.groups">
        <field name="name">GxP Approver</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_gxp_role_validator" model="res.groups">
        <field name="name">GxP Validator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_gxp_role_auditor_readonly" model="res.groups">
        <field name="name">GxP Auditor Readonly</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="rule_sheet_company" model="ir.rule">
        <field name="name">Controlled sheet company segregation</field>
        <field name="model_id" ref="model_gxp_controlled_sheet"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_gxp_role_author')), (4, ref('group_gxp_role_reviewer')), (4, ref('group_gxp_role_approver')), (4, ref('group_gxp_role_admin')), (4, ref('group_gxp_role_validator')), (4, ref('group_gxp_role_auditor_readonly'))]"/>
    </record>
    <record id="rule_version_company" model="ir.rule">
        <field name="name">Sheet version company segregation</field>
        <field name="model_id" ref="model_gxp_sheet_version"/>
        <field name="domain_force">[('sheet_id.company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_gxp_role_author')), (4, ref('group_gxp_role_reviewer')), (4, ref('group_gxp_role_approver')), (4, ref('group_gxp_role_admin')), (4, ref('group_gxp_role_validator')), (4, ref('group_gxp_role_auditor_readonly'))]"/>
    </record>
</odoo>
