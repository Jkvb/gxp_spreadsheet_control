<odoo>
    <record id="view_gxp_sheet_version_tree" model="ir.ui.view">
        <field name="name">gxp.sheet.version.tree</field>
        <field name="model">gxp.sheet.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sheet_id"/>
                <field name="version_label"/>
                <field name="state"/>
                <field name="file_sha256"/>
                <field name="is_locked"/>
            </tree>
        </field>
    </record>
    <record id="view_gxp_sheet_version_form" model="ir.ui.view">
        <field name="name">gxp.sheet.version.form</field>
        <field name="model">gxp.sheet.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_review" type="object" string="Enviar a revisión" states="draft"/>
                    <button name="action_to_pending_approval" type="object" string="A aprobación" states="in_review"/>
                    <button name="action_open_sign_wizard_review" type="object" string="Firmar revisión" states="in_review" class="btn-secondary"/>
                    <button name="action_make_effective" type="object" string="Hacer vigente" states="pending_approval"/>
                    <button name="action_open_sign_wizard_approval" type="object" string="Firmar aprobación" states="pending_approval" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_review,pending_approval,effective,superseded,retired,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="sheet_id"/>
                        <field name="version_major"/>
                        <field name="version_minor"/>
                        <field name="version_label" readonly="1"/>
                        <field name="web_edit_mode"/>
                        <field name="file_name"/>
                        <field name="file_binary" filename="file_name"/>
                        <field name="file_sha256" readonly="1"/>
                        <field name="change_summary"/>
                        <field name="is_locked" readonly="1"/>
                        <field name="use_chatter_audit" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Contenido web (navegador)">
                            <field name="web_line_ids" context="{'default_version_id': active_id}">
                                <tree editable="bottom">
                                    <field name="row_no"/>
                                    <field name="value_1"/>
                                    <field name="value_2"/>
                                    <field name="value_3"/>
                                    <field name="value_4"/>
                                    <field name="value_5"/>
                                    <field name="value_6"/>
                                    <field name="value_7"/>
                                    <field name="value_8"/>
                                    <field name="value_9"/>
                                    <field name="value_10"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_gxp_sheet_version" model="ir.actions.act_window">
        <field name="name">Versiones de hoja</field>
        <field name="res_model">gxp.sheet.version</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_gxp_version" name="Versiones" parent="menu_gxp_root" action="action_gxp_sheet_version"/>
</odoo>
